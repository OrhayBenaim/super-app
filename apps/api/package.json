{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/api.ts",
    "start": "node src/api.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ingest": "node src/worker.ts ingest-prices",
    "fetch": "node src/worker.ts fetch-prices",
    "geocode": "node src/worker.ts geocode-stores"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/expo": "^1.7.14",
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

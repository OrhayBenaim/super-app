PORT=3000
DATABASE_URL=./data/grocer.db
# Public URL of this API (OAuth callbacks). Secret: `openssl rand -base64 32`.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars
# Extra comma-separated trusted origins (also used for CORS), e.g. https://grocer.app
TRUSTED_ORIGINS=
# Optional social sign-in; each provider is enabled only when its vars are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=com.grocer.app
# Email (Resend). Required: the API refuses to start without it. EMAIL_FROM default: Grocer <no-reply@example.com>.
RESEND_API_KEY=
EMAIL_FROM=
# Geocoder for `npm run geocode` (default https://nominatim.openstreetmap.org; self-host for bulk runs).
NOMINATIM_URL=
# Scheduled sync times for `npm run worker`, HH:MM in Asia/Jerusalem time (default 05:00,12:00,23:30).
SYNC_TIMES=
# Private trigger for Manual syncs (POST /sync, Authorization: Bearer <token>); starts only when SYNC_TOKEN is set.
# Bind it to an internal address only (default 127.0.0.1:3001). Token: `openssl rand -base64 32`.
SYNC_TOKEN=
INTERNAL_PORT=3001
INTERNAL_HOST=127.0.0.1

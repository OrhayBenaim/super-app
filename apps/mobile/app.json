{
  "expo": {
    "name": "Grocer",
    "slug": "grocer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.ottersprod.grocer",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "waze"
        ],
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3446D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ottersprod.grocer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "he",
            "en"
          ]
        }
      ],
      "expo-image",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Grocer alerts you when you are near a store where your list is cheapest.",
          "locationWhenInUsePermission": "Grocer uses your location to find nearby supermarkets.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3446D6",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "grocer",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}

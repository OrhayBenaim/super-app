EXPO_PUBLIC_API_URL=http://localhost:3000
# Sentry: one project, grocer, for API and mobile (same DSN as the API's SENTRY_DSN). Unset DSN: the SDK stays off.
EXPO_PUBLIC_SENTRY_DSN=
# Source map upload during native/EAS builds only (keep the token out of git; set it as an EAS secret).
SENTRY_ORG=
SENTRY_PROJECT=grocer
SENTRY_AUTH_TOKEN=
# Product analytics (PostHog project key). Off when unset. Host default: https://eu.i.posthog.com (EU cloud).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
